# Isolated QA-only runner. Does not publish the LOUREX web application.
FROM mcr.microsoft.com/playwright:v1.55.0-noble
ENV DEBIAN_FRONTEND=noninteractive
ENV CI=1 PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates git \
  && curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
  && apt-get install -y --no-install-recommends nodejs \
  && node --version \
  && rm -rf /var/lib/apt/lists/*
COPY scripts/b09-final-render-qa.sh /usr/local/bin/b09-final-render-qa.sh
RUN chmod +x /usr/local/bin/b09-final-render-qa.sh
# Invalidate build cache on every changed source, contract or QA script.
COPY . /tmp/b09final-build-source/
RUN /usr/local/bin/b09-final-render-qa.sh
CMD ["node","-e","require('node:http').createServer((q,s)=>{s.writeHead(200,{'Content-Type':'text/plain'});s.end('LOUREX Batch 9 QA only; not production');}).listen(process.env.PORT||10000,'0.0.0.0')"]
