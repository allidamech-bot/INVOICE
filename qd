#!/usr/bin/env bash
# Retry ONLY the nine failed browser suites against the exact previously tested
# checkout; no source edits, new build, emulator, paid workflow, merge or deploy.
set -Eeuo pipefail
cd "$(git rev-parse --show-toplevel)"
[[ "$(git branch --show-current)" == "feat/fiscal-batch2-remaining-settlements" ]] || { echo "Wrong branch"; exit 1; }
sha=5f140ecbc70f8d58d5bd345c06994edc19ba34ad
old=/tmp/lourex-final-5f140ecbc70f.log
[[ -f "$old" ]] || { echo "Missing previous log; stop."; exit 1; }
work="$(git worktree list --porcelain | awk -v sha="$sha" '/^worktree /{w=substr($0,10)} $1=="HEAD"&&$2==sha&&w~/^\/tmp\/lourex-final-/{print w;exit}')"
[[ -n "$work" && -d "$work/node_modules/playwright" && -d "$work/dist" ]] || { echo "Previous QA checkout unavailable; stop."; exit 1; }
cd "$work"
[[ "$(git rev-parse HEAD)" == "$sha" ]] || exit 1
git diff --quiet && git diff --cached --quiet || { echo "Tested source has changed; stop."; exit 1; }
# The previous environment had 64 MiB /dev/shm. Try increasing the isolated
# container mount without relaxing sandboxing or changing browser semantics.
if [[ "$(df -BM /dev/shm | awk 'END{gsub(/M/,"",$2);print $2}')" -lt 512 ]]; then
  sudo -n mount -o remount,size=1G /dev/shm 2>/dev/null || echo "Shared-memory remount unavailable; remaining crashes will be reported."
fi
df -h /dev/shm | tail -n 1
# Surface the exact safe color assertion (RGB only), not application data.
python3 - "$old" <<'PY'
import re,sys
s=open(sys.argv[1],errors='replace').read()
for m in re.finditer(r'light party card must use its local surface ink',s):
    part=s[max(0,m.start()-100):m.end()+1200]
    colors=re.findall(r'rgb\(\d{1,3},\s*\d{1,3},\s*\d{1,3}\)',part)
    if colors:
        print("Prior party-card color values:", ", ".join(dict.fromkeys(colors)))
        break
PY
out="$(mktemp -d /tmp/lourex-browser-retry-XXXXX)"
node node_modules/http-server/bin/http-server . -a 127.0.0.1 -p 4173 -c-1 >"$out/server.log" 2>&1 &
server=$!
trap 'kill "$server" 2>/dev/null || true' EXIT
for i in $(seq 1 30); do
  kill -0 "$server" 2>/dev/null || { echo "Local server failed; stop."; exit 1; }
  if curl -fsS http://127.0.0.1:4173/tests/visual/template-visual-qa.html >/dev/null; then break; fi
  sleep 1
done
curl -fsS http://127.0.0.1:4173/tests/visual/template-visual-qa.html >/dev/null
names=(v337-shell-navigation v339-shell-overlay-release search-keyboard-batch1 ai-voice-reliability-batch5 ai-conversation-final-batch5 document-design-final-deep workspace-closeout-batch3 notification-recovery-batch3 v337-create-center)
seconds=(180 180 180 180 300 300 180 180 180)
fails=0
report="$out/SUMMARY.txt"
echo "Targeted browser diagnostic: $sha (9 distinct suites; not final signoff)" | tee "$report"
for i in "${!names[@]}"; do
  name="${names[$i]}"
  logfile="$out/$name.log"
  echo "RUN $name"
  if timeout --kill-after=10s "${seconds[$i]}s" node "tests/visual/run-$name.cjs" >"$logfile" 2>&1; then
    echo "PASS $name" | tee -a "$report"
  else
    code=$?
    fails=$((fails+1))
    echo "FAIL $name (exit $code)" | tee -a "$report"
    python3 - "$logfile" >>"$report" <<'PY'
import re,sys
s=open(sys.argv[1],errors='replace').read()
for token,pattern in [
("browser crash",r'\[QA browser crash\]|Page crashed'),
("closed browser",r'Target page, context or browser has been closed'),
("timeout",r'TimeoutError|Timeout \d+ms exceeded'),
("assertion",r'AssertionError|ERR_ASSERTION'),
("pageerror",r'\[QA pageerror\]')]:
    if re.search(pattern,s,re.I):print("  "+token)
for loc in list(dict.fromkeys(re.findall(r'tests/visual/run-[a-z0-9.-]+\.cjs:\d+:\d+',s)))[-3:]:print("  "+loc)
if "light party card must use its local surface ink" in s:
    print("  party card colors: "+", ".join(dict.fromkeys(re.findall(r'rgb\(\d{1,3},\s*\d{1,3},\s*\d{1,3}\)',s)))[:240])
PY
  fi
done
echo "RESULT: $((9-fails))/9 PASS, $fails FAIL" | tee -a "$report"
cat "$report"
echo "Logs: $out"
echo "No tests outside these nine were rerun; external authority acceptance remains separate."
[[ "$fails" == 0 ]]
