rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function shareTokenValid(shareId) {
      return shareId.matches('^[A-Za-z0-9_-]{43}$');
    }
    // Role claims can only originate from Firebase Admin SDK. In contrast,
    // the workspace's locally selected operator is untrusted for cloud ACLs.
    // Until separately authenticated team memberships exist, the entire
    // plaintext workspace document must ONLY be writable by its signed-in
    // Firebase owner, never by a signed finance/sales/purchasing staff claim.
    // Existing single-UID accounts have no custom role claim and remain owner.
    function businessAccount() {
      return request.auth != null
        && request.auth.token.firebase is map
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function trustedWorkspaceWriter() {
      return businessAccount()
        && (!('lourexAiRole' in request.auth.token)
          || request.auth.token.lourexAiRole == 'owner')
        && (!('lourexWorkspaceUid' in request.auth.token)
          || request.auth.token.lourexWorkspaceUid == request.auth.uid);
    }
    function ownerCreate() {
      return request.auth != null && request.resource.data.ownerUid == request.auth.uid;
    }
    function ownerExisting() {
      return request.auth != null && resource.data.ownerUid == request.auth.uid;
    }
    function customerPortal() {
      // Possession of a high-entropy share token grants this document only.
      // No Auth account is needed; existing anonymous sessions still work.
      return request.auth == null || request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    function shareActive() {
      return resource.data.revokedAt == null && resource.data.expiresAt is timestamp && request.time < resource.data.expiresAt;
    }
    function portalUpdateIsSafe() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return customerPortal()
        && shareActive()
        && changed.hasOnly(['viewedAt','customerComment','commentAt','decision','decisionAt','updatedAt'])
        && request.resource.data.updatedAt == request.time
        && (!changed.hasAny(['viewedAt']) || (resource.data.viewedAt == null && request.resource.data.viewedAt == request.time))
        && (!changed.hasAny(['customerComment','commentAt']) || (changed.hasAll(['customerComment','commentAt']) && request.resource.data.customerComment is string && request.resource.data.customerComment.size() <= 1000 && request.resource.data.commentAt == request.time))
        && (!changed.hasAny(['decision','decisionAt']) || (changed.hasAll(['decision','decisionAt']) && resource.data.allowDecision == true && resource.data.decision == '' && request.resource.data.decision in ['accepted','rejected'] && request.resource.data.decisionAt == request.time));
    }

    match /users/{userId}/{document=**} {
      allow read: if request.auth != null && request.auth.uid == userId && businessAccount();
      // A verified viewer/invalid employee claim cannot mutate the plaintext
      // workspace manifest, vault chunks, or history by bypassing the client.
      allow write: if request.auth != null && request.auth.uid == userId && trustedWorkspaceWriter();
    }

    match /publicShares/{shareId} {
      allow create: if shareTokenValid(shareId)
        && ownerCreate() && trustedWorkspaceWriter()
        && request.resource.data.format == 'LOUREX_SECURE_SHARE_V1'
        && request.resource.data.version == 1
        && request.resource.data.documentId is string
        && request.resource.data.customerId is string
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.revokedAt == null
        && request.resource.data.viewedAt == null
        && request.resource.data.decision == ''
        && request.resource.data.customerComment == '';
      allow get: if shareTokenValid(shareId) && (ownerExisting() || (customerPortal() && shareActive()));
      allow list: if ownerExisting();
      allow update: if (ownerExisting() && trustedWorkspaceWriter()) || (shareTokenValid(shareId) && portalUpdateIsSafe());
      allow delete: if ownerExisting() && trustedWorkspaceWriter();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
