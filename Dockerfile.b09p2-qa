# Batch 9.2 QA ONLY; not the LOUREX production application.
FROM mcr.microsoft.com/playwright:v1.55.0-noble
ENV DEBIAN_FRONTEND=noninteractive
ENV CI=1 PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates git \
  && curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
  && apt-get install -y --no-install-recommends nodejs \
  && node --version \
  && rm -rf /var/lib/apt/lists/*
COPY scripts/b09p2-render-qa.sh /usr/local/bin/b09p2-render-qa.sh
RUN chmod +x /usr/local/bin/b09p2-render-qa.sh
# Invalidate Docker cache if any source/contract/QA instruction changes.
COPY . /tmp/b09p2-reviewed-source/
RUN /usr/local/bin/b09p2-render-qa.sh
CMD ["node","-e","require('node:http').createServer((q,s)=>{s.writeHead(200,{'Content-Type':'text/plain'});s.end('LOUREX isolated QA marker; no production application');}).listen(process.env.PORT||10000,'0.0.0.0')"]
