#!/usr/bin/env bash
# Explicit developer sandbox only; no build or previous test rerun.
set -Eeuo pipefail
cd "$(git rev-parse --show-toplevel)"
[[ "$(git branch --show-current)" == "feat/fiscal-batch2-remaining-settlements" ]] || { echo "Wrong branch"; exit 1; }
[[ -f dist/src/lib/fiscal-issuance.js ]] || { echo "Existing compiled QA build required"; exit 1; }
# Require the exact unchanged fiscal/app source from the already tested checkout.
git diff --quiet 5f140ecbc70f8d58d5bd345c06994edc19ba34ad HEAD -- src api package.json package-lock.json scripts/fiscal/CanonicalInvoice.java || { echo "Fiscal source changed; rebuild required"; exit 1; }
git diff --quiet -- src api || { echo "Local changes; stop"; exit 1; }
node scripts/fiscal/developer-sandbox.mjs --live-developer-sandbox
