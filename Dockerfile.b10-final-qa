# Isolated free Render QA-only image. Do not deploy LOUREX application.
FROM mcr.microsoft.com/playwright:v1.55.0-noble
ENV DEBIAN_FRONTEND=noninteractive
ENV CI=1 PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates git \
  && curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
  && apt-get install -y --no-install-recommends nodejs \
  && node --version \
  && rm -rf /var/lib/apt/lists/*
COPY scripts/b10-final-render-qa.sh /usr/local/bin/b10-final-render-qa.sh
RUN chmod +x /usr/local/bin/b10-final-render-qa.sh
# Cache bust on every changed source, test, audit note or QA harness.
COPY . /tmp/b10final-build-source/
RUN /usr/local/bin/b10-final-render-qa.sh
CMD ["node","-e","require('node:http').createServer((q,s)=>{s.writeHead(200,{'Content-Type':'text/plain'});s.end('LOUREX B10 full QA only; production is unchanged');}).listen(process.env.PORT||10000,'0.0.0.0')"]
