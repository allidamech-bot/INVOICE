# Dedicated Batch 8 QA-only image; does NOT publish the LOUREX application.
# Render service must use plan=free and autoDeploy=no.
FROM mcr.microsoft.com/playwright:v1.55.0-noble
ENV DEBIAN_FRONTEND=noninteractive
ENV CI=1
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN apt-get update \
  && apt-get install -y --no-install-recommends curl ca-certificates git \
  && curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
  && apt-get install -y --no-install-recommends nodejs \
  && node --version \
  && rm -rf /var/lib/apt/lists/*
COPY scripts/b08-render-qa.sh /usr/local/bin/b08-render-qa.sh
RUN chmod +x /usr/local/bin/b08-render-qa.sh
RUN /usr/local/bin/b08-render-qa.sh
# A successful build proves the gated tests completed; runtime serves only a
# harmless QA marker and never exposes application or repository data.
CMD ["node","-e","require('node:http').createServer((q,s)=>{s.writeHead(200,{'Content-Type':'text/plain'});s.end('LOUREX Batch 8 QA only. No production application.');}).listen(process.env.PORT||10000,'0.0.0.0')"]
